# Encabezados del sitio en Cloudflare Workers (hosting de producción).
# HSTS: el navegador recuerda por 1 año que este dominio va solo por HTTPS.
# Sin includeSubDomains ni preload a propósito: los subdominios son del correo de GoDaddy.
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/images/*
  Cache-Control: public, max-age=31536000, immutable

/public/images/*
  Cache-Control: public, max-age=31536000, immutable

# CSS y JS del panel: 5 minutos sin volver a consultar al servidor al cambiar
# de módulo. Corto a propósito: después de publicar, en 5 minutos todos ven lo nuevo.
/admin/css/*
  Cache-Control: public, max-age=300

/admin/js/*
  Cache-Control: public, max-age=300
